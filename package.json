{
  "name": "creative-ideas-pitcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "metrics": "node scripts/metrics.js",
    "test": "node --test \"test/**/*.test.js\"",
    "app": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.socklock.idea-generator",
    "productName": "Idea Generator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "package.json",
      "!**/*.test.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
